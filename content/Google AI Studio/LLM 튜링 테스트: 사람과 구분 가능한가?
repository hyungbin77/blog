nglish\u0027)\nexcept LookupError:\n    print(\"NLTK stopwords 다운로드 중...\")\n    nltk.download(\u0027stopwords\u0027)\nstop_words_en \u003d set(stopwords.words(\u0027english\u0027))\ndef preprocess_text(text):\n    \"\"\"텍스트 전처리: 소문자, 구두점 제거, 불용어 제거\"\"\"\n    if not isinstance(text, str):\n        return \"\"\n    text \u003d text.lower() # 소문자\n    text \u003d re.sub(r\u0027[^a-z0-9\\s]\u0027, \u0027\u0027, text) # 알파벳, 숫자, 공백 외 제거\n    words \u003d text.split() # 토큰화 (공백 기준)\n    # 불용어 제거 및 한 글자 단어 제거\n    words \u003d [word for word in words if word not in stop_words_en and len(word) \u003e 1]\n    return \u0027 \u0027.join(words)\n\n# \u0027Answer\u0027 컬럼 전처리 및 새 컬럼 생성 (NaN 처리 포함)\n# \u0027data\u0027 DataFrame 사용\ndata[\u0027processed_answer\u0027] \u003d data[\u0027Answer\u0027].fillna(\u0027\u0027).apply(preprocess_text)\n# --- 2. TF-IDF 벡터화 (전체 데이터 기준) ---\n# 최소 2개 문서 이상 등장, 최대 90% 이하 문서에 등장하는 단어만 사용 (조정 가능)\nvectorizer \u003d TfidfVectorizer(min_df\u003d2, max_df\u003d0.90, ngram_range\u003d(1, 2)) # 유니그램 및 바이그램 포함\n# \u0027data\u0027 DataFrame 사용\ntfidf_matrix \u003d vectorizer.fit_transform(data[\u0027processed_answer\u0027])\nfeature_names \u003d vectorizer.get_feature_names_out() # 단어(피처) 목록\n\n# TF-IDF 결과를 DataFrame으로 변환 (분석 편의상)\n# \u0027data\u0027 DataFrame의 인덱스 사용\ntfidf_df \u003d pd.DataFrame(tfidf_matrix.toarray(), columns\u003dfeature_names, index\u003ddata.index)\ntfidf_df\nimport pandas as pd\n\n# --- 3. 분석 1: 모델별 평균 TF-IDF 및 상위 키워드 ---\nprint(\"\\n--- 분석 1: 모델별 전반적인 상위 TF-IDF 키워드 ---\")\n\n# \u0027tfidf_df\u0027 DataFrame과 \u0027data\u0027 DataFrame이 준비되었다고 가정\n\n# \u0027model\u0027 컬럼명 사용 (소문자 가정, 필요시 확인/수정)\nif \u0027model\u0027 in data.columns:\n    # tfidf_df에 \u0027model\u0027 컬럼이 있는지 확인하고, 있다면 이름을 임시로 변경\n    tfidf_renamed_df \u003d tfidf_df.copy() # 원본 수정을 피하기 위해 복사\n    if \u0027model\u0027 in tfidf_renamed_df.columns:\n        print(\"경고: TF-IDF DataFrame에 \u0027model\u0027 컬럼이 존재합니다. 임시로 이름을 변경합니다.\")\n        # 충돌하지 않는 새 이름으로 변경 (예