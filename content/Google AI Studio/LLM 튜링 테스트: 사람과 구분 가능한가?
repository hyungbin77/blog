    }, {
      "text": "일단 나의 코드를 다 보여줄게, 너의 방법들도 좋아 \nall_answers[\"char_count\"]  \u003d all_answers[\"Answer\"].str.len()\nall_answers[\u0027word_count\u0027] \u003d all_answers[\u0027Answer\u0027].apply(lambda x: len(str(x).split()))\ndef count_unique_words(text):\n    \"\"\"텍스트 내 고유 단어 수 계산 (간단 전처리 포함)\"\"\"\n    if not isinstance(text, str): return 0\n    # 소문자 변환, 간단한 구두점 제거(알파벳, 숫자, 공백 외 제거), 공백 기준 분리\n    words \u003d re.sub(r\u0027[^a-z0-9\\s]\u0027, \u0027\u0027, str(text).lower()).split()\n    return len(set(w for w in words if w)) # 고유 단어 수 세기 (빈 문자열 제외)\ndata[\u0027Answer_clean\u0027] \u003d data[\u0027Answer\u0027].fillna(\u0027\u0027) # NaN을 빈 문자열로\ndata[\u0027char_count\u0027] \u003d data[\u0027Answer_clean\u0027].str.len()\ndata[\u0027word_count\u0027] \u003d data[\u0027Answer_clean\u0027].apply(lambda x: len(x.split()))\n# 문장 끝 기호(.!?)가 하나도 없어도 문장은 1개로 간주 (빈 문자열은 0개)\ndata[\u0027sentence_count\u0027] \u003d data[\u0027Answer_clean\u0027].apply(lambda x: len(re.findall(r\u0027[.!?]+\u0027, x)) + 1 if x.strip() else 0)\ndata[\u0027unique_word_count\u0027] \u003d data[\u0027Answer_clean\u0027].apply(count_unique_words)\ndata[\u0027avg_sentence_length\u0027] \u003d np.where(data[\u0027sentence_count\u0027] \u003e 0, data[\u0027word_count\u0027] / data[\u0027sentence_count\u0027], 0)\ndata[\u0027avg_word_length\u0027] \u003d np.where(data[\u0027word_count\u0027] \u003e 0, data[\u0027char_count\u0027] / data[\u0027word_count\u0027], 0)\ndata[\u0027lexical_density\u0027] \u003d np.where(data[\u0027word_count\u0027] \u003e 0, data[\u0027unique_word_count\u0027] / data[\u0027word_count\u0027], 0)\nmetrics_to_analyze \u003d [\n    \u0027char_count\u0027, \u0027word_count\u0027, \u0027sentence_count\u0027,\n    \u0027avg_sentence_length\u0027, \u0027avg_word_length\u0027,\n    \u0027unique_word_count\u0027, \u0027lexical_density\u0027\n]\nif \u0027model\u0027 in data.columns:\n    # 모델 이름을 문자열로 변환 (만약 다른 타입이 섞여있을 경우 대비)\n    data[\u0027model\u0027] \u003d data[\u0027