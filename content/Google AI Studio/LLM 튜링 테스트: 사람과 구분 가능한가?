df_by_model \u003d tfidf_with_model.groupby(\u0027model\u0027).mean().transpose()\n\n        # 각 모델별 상위 N개 키워드 출력\n        top_n \u003d 15 # 상위 몇 개 키워드를 볼지 설정\n        for model_name in mean_tfidf_by_model.columns:\n            print(f\"\\n--- {model_name} (Top {top_n} Keywords) ---\")\n            # 점수가 0보다 큰 키워드만 대상으로 정렬 후 상위 N개 선택\n            top_words \u003d mean_tfidf_by_model[model_name][mean_tfidf_by_model[model_name] \u003e 0].sort_values(ascending\u003dFalse).head(top_n)\n            pd.set_option(\u0027display.float_format\u0027, lambda x: \u0027%.4f\u0027 % x) # 소수점 4자리 표시\n            print(top_words)\n            pd.reset_option(\u0027display.float_format\u0027) # 원래 포맷 복구\n\n    except ValueError as e:\n        print(f\"오류 발생: {e}\")\n    except KeyError as e:\n        print(f\"오류 발생: \u0027{e}\u0027 컬럼을 찾을 수 없습니다. DataFrame 컬럼명을 확인하세요.\")\n\nelse:\n    print(\"오류: \u0027data\u0027 DataFrame에 \u0027model\u0027 컬럼이 없습니다.\")\n\u0027Attempt\u0027 열 이동 후:\n    model                                           Question  Attempt  \\\n0  claude  What is the biggest lesson that life has taugh...        1   \n1  claude  What is the biggest lesson that life has taugh...        2   \n2  claude  What is the biggest lesson that life has taugh...        3   \n3  claude  What is the biggest lesson that life has taugh...        4   \n4  claude  What is the biggest lesson that life has taugh...        5   \n\n                                              Answer  \n0  # Life\u0027s Biggest Lesson\\n\\nThe most profound l...  \n1  # Life\u0027s Biggest Lesson\\n\\nThe most profound l...  \n2  # Life\u0027s Greatest Lesson\\n\\nThe most profound ...  \n3  # Life\u0027s Greatest Lesson\\n\\nThe most profound ...  \n4  # Life\u0027s Greatest Lesson\\n\\nThe biggest lesson...  \n\u0027Attempt\u0027 열 이동 후:\n       model                                           Question  Attempt  \\\n0  deep seek  What is the biggest lesson that life has taugh...        1   \n1  deep seek  Wh