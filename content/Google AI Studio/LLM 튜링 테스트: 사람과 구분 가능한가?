# HTML 태그 제거\n    # 모든 문자를 소문자로 변환 (태깅 전에 소문자 통일)\n    cleaned_text \u003d cleaned_text.lower()\n\n\n    # 단어 토큰화\n    words \u003d nltk.word_tokenize(cleaned_text)\n\n    if not words: # 토큰화 후 단어가 없는 경우 처리\n        return {}\n\n    # 품사(POS) 태깅\n    # nltk.pos_tag는 영어 텍스트에 대해 Penn Treebank 태그셋을 사용합니다.\n    pos_tags \u003d nltk.pos_tag(words)\n\n    # 품사 태그만 추출하여 빈도 계산\n    tags \u003d [tag for (word, tag) in pos_tags]\n    tag_counts \u003d Counter(tags)\n\n    # 전체 단어 수 (토큰 기준)\n    total_tags \u003d len(tags) # len(words)와 동일해야 함\n\n    # 품사별 비율 계산\n    pos_distribution \u003d {tag: count / total_tags for tag, count in tag_counts.items()}\n\n    return pos_distribution\n\n# ------------------------------\n# 2. 데이터프레임에 품사 분포 적용\n# ------------------------------\n\n# \u0027Answer\u0027 컬럼의 NaN 값을 빈 문자열로 처리하여 함수에 입력\n# 만약 이미 Answer_clean 컬럼이 있다면, 아래 줄을 수정하거나 건너뛰고 Cleaned_Answer를 사용하세요.\ndata[\u0027Answer_safe\u0027] \u003d data[\u0027Answer\u0027].fillna(\u0027\u0027)\n\n\n# 각 답변에 대해 품사 분포 계산 및 새로운 컬럼 생성\n# 결과는 각 행에 품사 비율 딕셔너리를 담은 Series가 됩니다.\npos_series \u003d data[\u0027Answer_safe\u0027].apply(get_pos_distribution)\n\n# Series of dict를 DataFrame으로 변환\n# 각 품사 태그가 컬럼이 되고, 값이 해당 비율이 됩니다.\npos_df \u003d pd.DataFrame(pos_series.tolist())\n\n# 원본 데이터프레임과 결합 (index를 기준으로 결합됩니다)\n# NaN 값은 해당 품사가 답변에 없었음을 의미하므로 0으로 채웁니다.\ndata_with_pos \u003d pd.concat([data, pos_df], axis\u003d1).fillna(0)\n\n# 원본 Answer_safe 컬럼은 이제 필요 없으므로 삭제\ndata_with_pos \u003d data_with_pos.drop(columns\u003d[\u0027Answer_safe\u0027])\n\nprint(\"--- 품사 분포 분석 결과 (샘플) ---\")\nprint(data_with_pos.head())\nprint(f\"\\n총 {len(pos_df.columns)}개의 고유 품사 태그가 발견되었습니다.\")\n\n# ------------------------------\n# 3. 모델별 품사 비율 통계 및 시각화\n# ------------------------------\n\n# 모델별 평균 품사 비율 계산\nif \u0027model\u0027 in data_with_pos.columns:\n    # 품사 태그 컬럼만 선택\n    # \u0027model\u0027, \u0027Question\u0027, \u0027Attempt\u0027, \u0027Answer\u0027 컬럼 등을 제외\n    pos_tag_columns \u003d pos_df.columns.tolist() # pos_df의 컬럼 목록이 순수 품사 태그 컬럼\n\n    # 계산된 품사 비율 컬럼들만 그룹화하여 평균 계산\n    avg_pos_by_model \u003d data_with_pos.groupby(\u0027model\u0027)[pos_tag_columns].mean()\n\n    print(\"\\n--- 모델별 평균 품사 비율 ---\")\n    # 중요한 몇 가지 품사 태그만 출력하거나, 상위 N개 태그를 선택하여 출력 가능\n    # Penn Treebank Tag Set (자주 나오는 것들):\n    # NN: 명사, 단수/질량형\n    # NNS: 명사, 복수\n    # NNP: 고유명사, 단수\n    # NNPS: 고유명사, 복수\n    # VB: 동사, 기본형\n    # VBD: 동사, 과거형\n    # VBG: 동사, 현재분사/동명사\n    # VBN: 동사, 과거분사\n    # VBP: 동사, 현재형 (1, 2인칭 단/복수; 3인칭 복수)\n    # VBZ: 동사, 현재형 (3인칭 단수)\n    # JJ: 형용사\n    # JJR: 형용사, 비교급\n    # JJS: 형용사, 최상급\n    # RB: 부사\n    # RBR: 부사, 비교급\n    # RBS: 부사, 최상급\n    # IN: 전치사 또는 종속접속사\n    # DT: 한정사 (a, the, this, that 등)\n    # PRPS: 소유격 대명사 (my, his, her, our, their)\n    # PRP: 인칭 대명사 (I, he, she, it, we, they, you)\n    # CC: 등위접속사 (and, but, or)\n    # CD: 기수 (숫자)\n    # WDT: wh-한정사 (which, what)\n    # WP: wh-대명사 (who, what, whom, which)\n    # WRB: wh-부사 (where, when, why)\n\n    # 관심 있는 품사 태그 리스트 (조절 가능)\n    # 데이터에서 실제로 나타난 품사 태그 중에서 선택하는 것이 안전합니다.\n    # 위에서 pos_df.columns.tolist()로 확인 가능\n    relevant_pos_tags \u003d [\u0027NN\u0027, \u0027NNS\u0027, \u0027VB\u0027, \u0027VBD\u0027, \u0027VBG\u0027, \u0027VBN\u0027, \u0027VBP\u0027, \u0027VBZ\u0027,\n                         \u0027JJ\u0027, \u0027RB\u0027, \u0027IN\u0027, \u0027DT\u0027, \u0027PRP\u0027, \u0027PRPS\u0027, \u0027CC\u0027]\n    # 실제로 데이터에 존재하는 태그만 선택\n    present_relevant_pos_tags \u003d [tag for tag in relevant_pos_tags if tag in avg_pos_by_model.columns]\n\n    if present_relevant_pos_tags:\n         # 선택된 품사 태그의 평균 비율 출력 (소수점 4자리)\n         print(avg_pos_by_model[present_relevant_pos_tags].to_string(float_format\u003d\u0027%.4f\u0027))\n\n         # 시각화 (Box plot) - 몇 가지 대표적인 품사 태그에 대해 수행\n         # 전체 품사를 다 그리면 복잡하므로, 중요한 몇 개만 선택\n         tags_to_plot \u003d [\u0027NN\u0027, \u0027VB\u0027, \u0027JJ\u0027, \u0027RB\u0027, \u0027PRP\u0027, \u0027IN\u0027] # 대표적인 태그 예시 (데이터에 있는지 확인 필요)\n         present_tags_to_plot \u003d [tag for tag in tags_to_plot if tag in data_with_pos.columns]\n\n         if present_tags_to_plot:\n             n_tags_plot \u003d len(present_tags_to_plot)\n             n_cols_plot \u003d 2\n             n_rows_plot \u003d (n_tags_plot + n_cols_plot - 1) // n_cols_plot\n\n             fig_pos, axes_pos \u003d plt.subplots(n_rows_plot, n_cols_plot, figsize\u003d(7 * n_cols_plot, 5 * n_rows_plot))\n             axes_pos \u003d axes_pos.flatten() if n_tags_plot \u003e 1 else [axes_pos] # 1개일 경우 리스트로 감싸기\n\n             unique_models \u003d sorted(data_with_pos[\u0027model\u0027].unique()) # 모델 이름 정렬\n             palette \u003d sns.color_palette(\"husl\", len(unique_models)) # 모델별 색상\n\n             for i, tag in enumerate(present_tags_to_plot):\n                 sns.boxplot(data\u003ddata_with_pos, x\u003d\u0027model\u0027, y\u003dtag, ax\u003daxes_pos[i], palette\u003dpalette, showfliers\u003dFalse, order\u003dunique_models)\n                 axes_pos[i].set_title(f\u0027Distribution of \"{tag}\" (POS Tag)\u0027, fontsize\u003d14)\n                 axes_pos[i].set_xlabel(\u0027Model\u0027, fontsize\u003d12)\n                 axes_pos[i].set_ylabel(f\u0027Proportion of \"{tag}\"\u0027, fontsize\u003d12)\n                 axes_pos[i].tick_params(axis\u003d\u0027x\u0027, rotation\u003d45, labelsize\u003d10)\n                 axes_pos[i].tick_params(axis\u003d\u0027y\u0027, labelsize\u003d10)\n\n             # 빈 subplot 제거\n             for j in range(i + 1, len(axes_pos)): fig_pos.delaxes(axes_pos[j])\n             fig_pos.suptitle(\u0027Comparison of Part-of-Speech Tag Proportions by Model (Box Plots)\u0027, fontsize\u003d18, y\u003d1.03)\n             plt.tight_layout(rect\u003d[0, 0.03, 1, 0.99]) # 레이아웃 조정\n             plt.show()\n         else:\n             print(\"\\n선택된 대표 품사 태그가 데이터에 존재하지 않습니다.\")\n\n    else:\n         print(\"\\n데이터에 품사 태그 컬럼이 존재하지 않습니다. get_pos_distribution 함수의 반환 값을 확인하세요.\")\n\nelse:\n    print(\"오류: \u0027data\u0027 DataFrame에 \u0027model\u0027 컬럼이 없습니다.\")\n\n```\n\n**코드 설명:**\n\n1.  **NLTK 다운로드:** `punkt` (단어 토큰화)와 `averaged_perceptron_tagger` (POS 태거) 리소스를 다운로드합니다. 처음 실행할 때만 필요하며, 이미 다운로드했다면 건너뜀니다.\n2.  **`get_pos_distribution` 함수 정의:**\n    *   입력으로 텍스트 문자열을 받습니다.\n    *   비어있거나 `NaN`인 경우를 안전하게 처리합니다.\n    *   기본적인 클렌징(URL, HTML 태그 제거, 소문자 변환)을 수행합니다. 더 복잡한 클렌징이 필요하면 이전에 사용하신 `clean_text` 함수 로직을 여기에 통합할 수 있습니다.\n    *   `nltk.word_tokenize`를 사용하여 텍스트를 단어 목록으로 분할합니다.\n    *   `nltk.pos_tag`를 사용하여 각 단어에 해당하는 품사 태그를 붙입니다.\n    *   `collections.Counter`를 사용하여 각 품사 태그의 빈도를 계산합니다.\n    *   전체 단어 수로 나누어 각 품사 태그의 비율을 계산하고 딕셔너리 형태로 반환합니다.\n3.  **데이터프레임에 품사 분포 적용:**\n    *   `data[\u0027Answer\u0027]` 컬럼에 `fillna(\u0027\u0027)`를 적용하여 `NaN` 값을 빈 문자열로 바꾼 안전한 컬럼(`Answer_safe`)을 만듭니다.\n    *   `apply(get_pos_distribution)`를 사용하여 각 답변에 대해 품사 비율 딕셔너리를 계산합니다.\n    *   `apply(pd.Series)`를 사용하여 이 딕셔너리 Series를 DataFrame으로 변환합니다. 각 고유 품사 태그가 새로운 컬럼이 됩니다.\n    *   원본 `data` DataFrame과 이 `pos_df`를 `pd.concat`으로 결합합니다. 기본적으로 index를 기준으로 병합됩니다.\n    *   `fillna(0)`를 사용하여 어떤 답변에는 나타나지 않은 품사 태그 컬럼의 `NaN` 값을 0으로 채웁니다.\n4.  **모델별 통계 및 시각화:**\n    *   `data_with_pos` DataFrame을 \u0027model\u0027 컬럼으로 그룹화합니다.\n    *   그룹화된 DataFrame에서 순수 품사 태그 컬럼들만 선택하여 `mean()` 메서드를 적용, 모델별 평균 품사 비율을 계산합니다.\n    *   Penn Treebank 태그셋 중 자주 사용되거나 분석에 유용할 것으로 예상되는 몇 가지 품사 태그(`relevant_pos_tags`, `tags_to_plot`)를 선택하여 결과를 출력하고 박스 플롯으로 시각화합니다.\n    *   박스 플롯은 각 모델별 특정 품사 비율의 분포를 보여주므로, 평균뿐 아니라 변동성까지 함께 비교할 수 있습니다. `showfliers\u003dFalse` 옵션으로 극단값(outliers)을 제외하여 분포의 핵심을 더 명확히 볼 수 있게 합니다.\n\n이 코드를 실행하면 각 모델(및 human)이 답변에서 어떤 품사를 어느 정도의 비율로 사용하는지에 대한 정량적인 데이터를 얻을 수 있으며, 이를 시각적으로 비교하여 모델별 언어 스타일 차이를 파악하는 데 큰 도움이 될 것입니다.\n\n이 결과는 앞서 계산한 길이 통계, 어휘 다양성, TF-IDF, SBERT 유사도와 함께 분류 모델의 Feature로 활용되어 모델의 성능을 향상시키고, 연구의 논의를 풍부하게 만들 수 있습니다.",
