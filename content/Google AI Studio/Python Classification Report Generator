ision\u0027]) else \u0027\u0027\n    r \u003d f\"{row[\u0027recall\u0027] * 100:.1f}%\" if pd.notna(row[\u0027recall\u0027]) else \u0027\u0027\n    f1 \u003d f\"{row[\u0027f1-score\u0027] * 100:.1f}%\" if pd.notna(row[\u0027f1-score\u0027]) else \u0027\u0027\n    plot_data.append([p, r, f1])\n\n# 4. 표 그리기\nfig, ax \u003d plt.subplots(figsize\u003d(7, 4.5)) # 제목이 없으므로 크기 미세 조정\nax.axis(\u0027tight\u0027)\nax.axis(\u0027off\u0027)\n\nthe_table \u003d ax.table(cellText\u003dplot_data,\n                     colLabels\u003ddf.columns,\n                     rowLabels\u003dfinal_df.index,\n                     loc\u003d\u0027center\u0027,\n                     cellLoc\u003d\u0027center\u0027)\n\n# 5. 스타일링 및 세로줄 제거\nthe_table.auto_set_font_size(False)\nthe_table.set_fontsize(12)\nthe_table.scale(1.2, 1.2)\naccuracy_row_index \u003d list(final_df.index).index(\u0027accuracy\u0027) + 1\nfor (row, col), cell in the_table.get_celld().items():\n    if (row \u003d\u003d 0) or (col \u003d\u003d -1):\n        cell.set_facecolor(\"#EAEAF2\")\n        cell.set_text_props(weight\u003d\u0027bold\u0027)\n    if row \u003d\u003d accuracy_row_index:\n        cell.set_facecolor(\u0027#F5F5F5\u0027)\n        cell.set_text_props(weight\u003d\u0027bold\u0027)\n        if col \u003d\u003d 0: cell.visible_edges \u003d \u0027LTB\u0027\n        elif col \u003d\u003d 1: cell.visible_edges \u003d \u0027TB\u0027\n        else: cell.visible_edges \u003d \u0027RTB\u0027\n    elif row \u003e 0 and final_df.index[row-1] in [\u0027macro avg\u0027, \u0027weighted avg\u0027]:\n        cell.set_facecolor(\u0027#F5F5F5\u0027)\n        cell.set_text_props(weight\u003d\u0027bold\u0027)\n\n# --- 제목(title) 부분 완전 제거 ---\n# plt.title(...) 라인을 삭제했습니다.\n\n# 6. 파일 저장 (새 이름으로)\nplt.savefig(\u0027classification_report_notitle.png\u0027, dpi\u003d300, bbox_inches\u003d\u0027tight\u0027, pad_inches\u003d0.1)\nplt.savefig(\u0027classification_report_notitle.pdf\u0027, dpi\u003d300, bbox_inches\u003d\u0027tight\u0027, pad_inches\u003d0.1)\n\nprint(\"제목이 없는 classification_report_notitle.png 파일이 저장되었습니다.\")\nplt.show()\n\n```\n\n---\n\n### 단계 2: 개선된 LaTeX 코드로 교체하기\n\n기존의 `center`, `makebox`, `minipage` 코드를 모두 지우고, 아래의 코드로 교체하세요. 이 코드는 논문에서 그림을 다루는 가장 표준적인 방법입니다.\n\n**요구사항:** 이 코드를 사용하려면 문서 맨 위에 `\\usepackage{graphicx}`와 `\\usepackage{subcaption}`이 선언되어 있어야 합니다.\n\n#### 최종 LaTeX 코드\n\n```latex\n\\begin{figure}[h!] % [h!] 옵션은 그림을 \u0027바로 여기(here!)\u0027에 위치시키라는 의미\n    \\centering % 그림 전체를 가운데 정렬\n    \n    \\begin{subfigure}[b]{0.48\\textwidth}\n        \\centering\n        \\includegraphics[width\u003d\\linewidth]{confusion_matrix.png}\n        \\caption{Confusion Matrix}\n        \\label{fig:confusion_matrix}\n    \\end{subfigure}\n    \\hfill % 두 그림 사이에 적절한 간격을 자동으로 추가\n    \\begin{subfigure}[b]{0.48\\textwidth}\n        \\centering\n        % 1단계에서 생성한 \u0027제목 없는\u0027 새 이미지 파일을 사용합니다.\n        \\includegraphics[width\u003d\\linewidth]{classification_report_notitle.png} \n        \\caption{Classification Report}\n        \\label{fig:report}\n    \\end{subfigure}\n    \n\\end{figure}\n```\n\n### 이렇게 바꾸면 좋은 점\n\n*   **자동 캡션:** `\\caption{}` 명령어가 \"Figure 1:\", \"Figure 2:\"와 같은 번호와 이름을 자동으로, 그리고 올바른 위치에 생성해 줍니다.\n*   **안정적인 배치:** `figure`와 `subcaption` 환경은 LaTeX에서 그림 배치를 위해 만들어진 공식적인 기능이라 훨씬 안정적입니다.\n*   **코드의 간결성:** 수동으로 위치를 잡는 것보다 코드가 훨씬 깔끔하고 이해하기 쉬워집니다.\n\n이제 LaTeX 문서를 컴파일하면 두 그림과 캡션이 완벽하게 정렬된 것을 보실 수 있습니다.",
