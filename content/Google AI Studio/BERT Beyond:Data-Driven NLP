sses\u003d50, random_state\u003d42, update_every\u003d1,\n                          eval_every\u003d1, alpha\u003d\u0027symmetric\u0027, eta\u003d\u0027auto\u0027)\n    print(\"메인 모델 학습 완료.\")\n\n    # --- 4. 서브토픽 분석 ---\n    print(\"\\n서브토픽 분석을 시작합니다...\")\n    \n    # 최종 결과를 저장할 DataFrame 미리 생성\n    result_df \u003d df[[\u0027model\u0027]].copy()\n    result_df.rename(columns\u003d{\u0027model\u0027: \u0027llm_name\u0027}, inplace\u003dTrue)\n    result_df[\u0027doc_id\u0027] \u003d df.index\n\n    subtopic_labels \u003d []  # 생성된 모든 서브토픽 라벨 저장\n    subtopic_words \u003d []   # 서브토픽별 키워드 저장\n    \n    # 메인 모델의 전체 문서에 대한 토픽 분포 계산\n    all_doc_topics \u003d main_model.get_document_topics(corpus, minimum_probability\u003d0)\n\n    for main_topic_id in range(optimal_topics):\n        print(f\"\\n[메인 토픽 {main_topic_id}에 대한 서브토픽 분석]\")\n        \n        # 1. 메인 토픽에 강하게 속하는 대표 문서 필터링\n        topic_docs_with_probs \u003d []\n        for doc_index, topic_dist in enumerate(all_doc_topics):\n            for t_id, prob in topic_dist:\n                if t_id \u003d\u003d main_topic_id:\n                    topic_docs_with_probs.append((doc_index, prob))\n                    \n        topic_docs_with_probs \u003d sorted(topic_docs_with_probs, key\u003dlambda x: x[1], reverse\u003dTrue)[:TOP_N_DOCS_FOR_SUBTOPIC]\n        doc_indices \u003d [idx for idx, _ in topic_docs_with_probs]\n        \n        if len(doc_indices) \u003c MIN_DOCS_FOR_SUBTOPIC:\n            print(f\"⚠️ 대표 문서가 {len(doc_indices)}개로 너무 적어 메인 토픽 {main_topic_id}의 서브토픽 분석을 건너뜁니다.\")\n            continue\n\n        # 2. 서브토픽 분석을 위한 \u0027미니\u0027 코퍼스 생성 (오직 대표 문서들만 사용)\n        filtered_tokens \u003d [tokens_list[i] for i in doc_indices]\n        sub_dict \u003d Dictionary(filtered_tokens)\n        sub_dict.filter_extremes(no_below\u003d3, no_above\u003d0.6) # 서브 코퍼스에 대한 필터링\n        sub_corpus \u003d [sub_dict.doc2bow(text) for text in filtered_tokens]\n\n        # 3. 최적 서브토픽 수 선택\n        sub_scores \u003d []\n        sub_topic_range \u003d range(2, 8)\n        for n in sub_topic_range:\n            try:\n                temp_model \u003d LdaModel(corpus\u003dsub_corpus, id2word\u003dsub_dict, num_topics\u003dn, passes\u003d15, random_state\u003d42)\n                cm \u003d CoherenceModel(model\u003dtemp_model, texts\u003dfiltered_tokens, dictionary\u003dsub_dict, coherence\u003d\u0027c_v\u0027)\n                sub_scores.append(cm.get_coherence())\n            except:\n                sub_scores.append(0) # 오류 발생 시 0점 처리\n        \n        if not sub_scores or max(sub_scores) \u003d\u003d 0:\n            print(f\"⚠️ 메인 토픽 {main_topic_id}의 최적 서브토픽 수를 결정할 수 없어 건너뜁니다.\")\n            continue\n            \n        best_n_subtopics \u003d sub_topic_range[np.argmax(sub_scores)]\n        print(f\"  \u003e 최적 서브토픽 수: {best_n_subtopics}\")\n\n        # 4. 서브모델 학습 (미니 코퍼스로 학습)\n        sub_model \u003d LdaModel(corpus\u003dsub_corpus, id2word\u003dsub_dict, num_topics\u003dbest_n_subtopics,\n                             passes\u003d50, random_state\u003d42, alpha\u003d\u0027auto\u0027)\n\n        # 5. 서브토픽 키워드 저장 및 라벨 생성\n        for sub_topic_id in range(best_n_subtopics):\n            label \u003d f\"T{main_topic_id}_Sub{sub_topic_id}\"\n            subtopic_labels.append(label)\n            terms \u003d sub_model.show_topic(sub_topic_id, topn\u003d15)\n            keywords \u003d \", \".join([word for word, weight in terms])\n            subtopic_words.append({\n                \"Main Topic\": main_topic_id,\n                \"Subtopic Label\": label,\n                \"Keywords\": keywords\n            })\n\n        # 6. 대표 문서들에 서브토픽 확률 분포 할당\n        sub_doc_topics \u003d sub_model.get_document_topics(sub_corpus, minimum_probability\u003d0.0)\n        for i, (original_doc_idx, doc_topic_dist) in enumerate(zip(doc_indices, sub_doc_topics)):\n            for t_id, prob in doc_topic_dist:\n                label \u003d f\"T{main_topic_id}_Sub{t_id}\"\n                result_df.loc[original_doc_idx, label] \u003d prob\n\n    # --- 5. 최종 결과 저장 ---\n    print(\"\\n분석 결과를 파일로 저장합니다...\")\n    \n    # 서브토픽이 할당되지 않은 셀(NaN)은 0으로 채움\n    result_df.fillna(0, inplace\u003dTrue)\n\n    # 컬럼 순서 정리 (고유 정보 + 토픽 분포)\n    # 생성된 라벨만으로 컬럼을 구성하여 오류 방지\n    final_cols \u003d [\u0027doc_id\u0027, \u0027llm_name\u0027] + sorted([col for col in subtopic_labels if col in result_df.columns])\n    result_df \u003d result_df[final_cols]\n\n    result_df.to_excel(OUTPUT_DIST_PATH, index\u003dFalse)\n    print(f\"저장 완료: {OUTPUT_DIST_PATH}\")\n\n    words_df \u003d pd.DataFrame(subtopic_words)\n    words_df.to_excel(OUTPUT_WORDS_PATH, index\u003dFalse)\n    print(f\"저장 완료: {OUTPUT_WORDS_PATH}\")\n    print(\"\\n모든 프로세스가 완료되었습니다.\")\n\n# --- 6. 실행 시작 ---\nif __name__ \u003d\u003d \u0027__main__\u0027:\n    # Windows에서 multiprocessing 사용 시 freeze_support()가 필요할 수 있습니다.\n    from multiprocessing import freeze_support\n    freeze_support()\n    main()\n\n이 결과는 뭐야? ",
