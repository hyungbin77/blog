elEncoder().fit_transform(df_full[\u0027llm_name\u0027])\nnum_classes_multi \u003d len(np.unique(y_multi_class))\n\n# Baseline: 모든 특징 사용\nX \u003d df_full[all_features].values\nresults[\u0027Multi-Class | All Features\u0027] \u003d train_and_evaluate(X, y_multi_class, num_classes_multi, \"모든 특징 사용\")\n\n# LDA 특징만 사용\nX \u003d df_full[lda_features].values\nresults[\u0027Multi-Class | LDA Only\u0027] \u003d train_and_evaluate(X, y_multi_class, num_classes_multi, \"LDA 특징만 사용\")\n\n# 문체론적 특징만 사용\nX \u003d df_full[stylometric_features].values\nresults[\u0027Multi-Class | Stylometric Only\u0027] \u003d train_and_evaluate(X, y_multi_class, num_classes_multi, \"문체론적 특징만 사용\")\n\n# --- 실험 2: 이진 분류 (Human vs LLM) ---\nprint(\"\\n--- 실험 2: 이진 분류 (Human vs LLM) ---\")\ndf_binary \u003d df_full.copy()\n# \u0027human\u0027이 아니면 모두 \u0027llm\u0027으로 변경\ndf_binary[\u0027llm_name\u0027] \u003d df_binary[\u0027llm_name\u0027].apply(lambda x: \u0027human\u0027 if x \u003d\u003d \u0027human\u0027 else \u0027llm\u0027)\ny_binary_class \u003d LabelEncoder().fit_transform(df_binary[\u0027llm_name\u0027])\nnum_classes_binary \u003d len(np.unique(y_binary_class))\n\n# Baseline: 모든 특징 사용\nX \u003d df_binary[all_features].values\nresults[\u0027Binary | All Features\u0027] \u003d train_and_evaluate(X, y_binary_class, num_classes_binary, \"모든 특징 사용\")\n\n# LDA 특징만 사용\nX \u003d df_binary[lda_features].values\nresults[\u0027Binary | LDA Only\u0027] \u003d train_and_evaluate(X, y_binary_class, num_classes_binary, \"LDA 특징만 사용\")\n\n# 문체론적 특징만 사용\nX \u003d df_binary[stylometric_features].values\nresults[\u0027Binary | Stylometric Only\u0027] \u003d train_and_evaluate(X, y_binary_class, num_classes_binary, \"문체론적 특징만 사용\")\n\n# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003