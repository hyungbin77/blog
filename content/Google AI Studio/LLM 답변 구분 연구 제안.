meError: # word_tokenize 등이 정의되지 않은 경우 (nltk 리소스 문제)\n            print(\"텍스트 전처리 중 오류: NLTK 토크나이저 또는 리소스 문제일 수 있습니다.\")\n            preprocessed_corpus \u003d None # 오류 시 None으로 설정\n\n        if preprocessed_corpus:\n            # --- 3. TF-IDF 계산 ---\n            vectorizer \u003d TfidfVectorizer(\n                max_features\u003d5000,\n                ngram_range\u003d(1, 1) \n            )\n\n            print(\"\\nTF-IDF를 계산 중입니다...\")\n            tfidf_matrix \u003d vectorizer.fit_transform(preprocessed_corpus)\n            print(\"TF-IDF 계산이 완료되었습니다.\")\n            print(f\"TF-IDF 행렬 형태: {tfidf_matrix.shape}\")\n            feature_names \u003d vectorizer.get_feature_names_out()\n\n            # --- 4. 결과 확인: 모델별 상위 N개 TF-IDF 단어 (수정된 부분) ---\n            def get_top_tfidf_words(tfidf_row, feature_names_list, top_n\u003d15): # top_n 기본값을 15로 변경\n                scores \u003d tfidf_row.toarray().flatten()\n                sorted_indices \u003d np.argsort(scores)[::-1]\n                \n                top_words \u003d []\n                for i in range(top_n): # top_n 만큼 반복\n                    if i \u003c len(sorted_indices):\n                        idx \u003d sorted_indices[i]\n                        if scores[idx] \u003e 0:\n                            top_words.append((feature_names_list[idx], scores[idx]))\n                return top_words\n\n            print(\"\\n--- 모델별 상위 TF-IDF 단어 (Top 15) ---\") # 제목 수정\n            for i, model_name in enumerate(model_labels_for_tfidf):\n                print(f\"\\n[ {model_name} ]\")\n                # top_n을 15로 명시적으로 전달 (이미 함수 기본값이 15지만, 명확성을 위해)\n                top_words \u003d get_top_tfidf_words(tfidf_matrix[i], feature_names, top_n\u003d15)\n                if top_words:\n                    for rank, (word, score) in enumerate(top_words, 1): # 순위도 함께 출력\n                        print(f\"  {rank}. {word}: {score:.4f}\")\n                else:\n                    print(\"  (해당 모델에 대한 TF-IDF 상위 단어를 찾을 수 없습니다.)\")\n\n            # (선택 사항) TF-IDF 결과를 DataFrame으로 만들어 보기\n            tfidf_df \u003d pd.DataFrame(tfidf_matrix.toarray(), index\u003dmodel_labels_for_tfidf, columns\u003dfeature_names)\n            print(\"\\n\\n--- TF-IDF Matrix (일부 샘플) ---\")\n            if not tfidf_df.empty:\n                 top_20_features_sum \u003d tfidf_df.sum(axis\u003d0).sort_values(ascending\u003dFalse).head(20).index\n                 print(tfidf_df[top_20_features_sum].head())\n            else:\n                 print(\"TF-IDF DataFrame이 비어있습니다.\")\n        else:\n            print(\"전처리된 코퍼스가 없어 TF-IDF 분석을 진행할 수 없습니다.\")\n    else:\n        print(\"통합된 코퍼스가 없어 TF-IDF 분석을 진행할 수 없습니다.\")\nelse:\n    print(\"데이터프레임(df)이 로드되지 않아 TF-IDF 분석을 진행할 수 없습니다.\")\n\n# tqdm import (만약 위에서 사용했다면)\nfrom tqdm import tqdm\n```\n\n**주요 변경점:**\n\n1.  **`get_top_tfidf_words` 함수:**\n    *   `top_n` 파라미터의 기본값을 `15`로 변경했습니다 (`def get_top_tfidf_words(tfidf_row, feature_names_list, top_n\u003d15):`).\n    *   함수 내부에서 `for i in range(top_n):` 루프가 `top_n` (즉, 15)번 반복하도록 되어 있습니다.\n2.  **출력 부분:**\n    *   출력 제목을 \"--- 모델별 상위 TF-IDF 단어 (Top 15) ---\" 로 수정했습니다.\n    *   `get_top_tfidf_words` 함수를 호출할 때 `top_n\u003d15`를 명시적으로 전달했습니다 (사실 함수 정의에서 기본값이 15로 바뀌었기 때문에 생략해도 동일하게 동작하지만, 코드의 가독성을 위해 남겨두었습니다).\n    *   각 단어 앞에 순위(1부터 15까지)를 추가하여 보기 좋게 만들었습니다: `print(f\"  {rank}. {word}: {score:.4f}\")`\n3.  **NLTK 리소스 확인 강화:** `stopwords`나 `lemmatizer` 로드 시 `LookupError`가 발생하면 안내 메시지를 출력하고, 해당 기능 없이 코드가 최소한으로 실행되도록 (결과는 부정확해질 수 있음) 수정했습니다. 전처리 중 `word_tokenize`에서 `NameError` 발생 시에도 안내합니다.\n4.  **tqdm 추가:** 텍스트 전처리 루프에 `tqdm`을 추가하여 진행 상황을 볼 수 있도록 했습니다.\n\n**실행 전 확인:**\n\n*   **NLTK 리소스:** 만약 NLTK의 `stopwords`, `wordnet`, `omw-1.4`, `punkt` 리소스가 다운로드되지 않았다면, 코드 상단 주석 처리된 부분을 해제하고 실행하거나, 별도의 Python 환경에서 다운로드해야 합니다.\n    ```python\n    import nltk\n    nltk.download(\u0027stopwords\u0027)\n    nltk.download(\u0027wordnet\u0027)\n    nltk.download(\u0027omw-1.4\u0027) # Open Multilingual Wordnet\n    nltk.download(\u00