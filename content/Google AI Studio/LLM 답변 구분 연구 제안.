ert_model \u003d SentenceTransformer(sbert_model_name)\n        print(f\"SBERT 모델 ({sbert_model_name})을 성공적으로 로드했습니다.\")\n    except Exception as e:\n        print(f\"SBERT 모델 로드 중 오류 발생: {e}\")\n        print(\"sentence-transformers 라이브러리가 올바르게 설치되어 있는지, 인터넷 연결이 되어있는지 확인해주세요.\")\n        sbert_model \u003d None\n\n    if sbert_model:\n        # --- 2. 분석할 데이터 선택 ---\n        # 예시: 첫 번째 고유 질문에 대한 각 모델의 첫 번째 답변(attempt \u003d\u003d 1)을 사용\n        \n        if \u0027question\u0027 not in df.columns or \u0027model\u0027 not in df.columns or \u0027answer\u0027 not in df.columns:\n            print(\"오류: 데이터프레임에 \u0027question\u0027, \u0027model\u0027, 또는 \u0027answer\u0027 컬럼이 없습니다.\")\n        else:\n            # 고유한 질문 목록 가져오기\n            unique_questions \u003d df[\u0027question\u0027].unique()\n            \n            if len(unique_questions) \u003e 0:\n                # 분석할 질문 선택 (예: 첫 번째 질문)\n                # 다른 질문으로 변경하고 싶으면 인덱스를 바꾸거나, 특정 질문 문자열을 직접 지정하세요.\n                # target_question \u003d \"Should I get a master\u0027s degree? Why or why not?\"\n                target_question_index \u003d 0 # 분석할 질문의 인덱스 (0부터 시작)\n                if target_question_index \u003c len(unique_questions):\n                    target_question \u003d unique_questions[target_question_index]\n                    print(f\"\\n분석 대상 질문 (인덱스 {target_question_index}): {target_question}\")\n\n                    # 해당 질문에 대한 답변 필터링\n                    df_target_question \u003d df[df[\u0027question\u0027] \u003d\u003d target_question].copy() # SettingWithCopyWarning 방지\n\n                    # \u0027answer\u0027 컬럼이 문자열인지 확인 및 변환\n                    df_target_question[\u0027answer\u0027] \u003d df_target_question[\u0027answer\u0027].astype(str)\n\n                    answers_to_compare \u003d []\n                    model_labels \u003d []\n                    \n                    # \u0027human\u0027을 포함한 모든 모델 순서 정의 (일관된 순서를 위해)\n                    model_order \u003d sorted(df