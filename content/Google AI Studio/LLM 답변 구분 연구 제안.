ze\u003d10)\n                            plt.yticks(rotation\u003d0, fontsize\u003d10)\n                            plt.tight_layout() # 레이아웃 자동 조절\n                            \n                            # 파일로 저장 (선택 사항)\n                            # output_filename \u003d f\"sbert_heatmap_q{target_question_index}.png\"\n                            # plt.savefig(output_filename)\n                            # print(f\"히트맵이 {output_filename}으로 저장되었습니다.\")\n                            \n                            plt.show()\n                            print(\"히트맵 생성이 완료되었습니다.\")\n\n                        except Exception as e_embed_viz:\n                            print(f\"임베딩 생성 또는 히트맵 시각화 중 오류 발생: {e_embed_viz}\")\n\n                    else:\n                        print(\"유사도를 비교할 답변이 충분하지 않습니다 (최소 2개 필요). 선택된 모델 및 attempt를 확인해주세요.\")\n                else:\n                    print(f\"선택한 질문 인덱스({target_question_index})가 유효한 범위를 벗어났습니다. (0 ~ {len(unique_questions)-1})\")\n            else:\n                print(\"데이터프레임에 고유한 질문이 없습니다.\")\n    else:\n        print(\"SBERT 모델이 로드되지 않아 분석을 진행할 수 없습니다.\")\nelse:\n    print(\"데이터프레임이 로드되지 않아 분석을 진행할 수 없습니다.\")\n\n```\n\n**주요 변경 및 확인 사항:**\n\n1.  **파일 경로 수정:**\n    ```python\n    file_path \u003d \u0027/Users/user/Desktop/coding/2025/NLP/combined_data_NLP.xlsx\u0027\n    ```\n    로 변경되었습니다.\n2.  **라이브러리 임포트:** `sentence_transformers`가 올바르게 임포트되는지 확인합니다. 만약 설치되어 있지 않다면, 터미널(또는 Anaconda Prompt)에서 설치해야 합니다.\n    ```bash\n    pip install sentence-transformers\n    # 또는 conda install -c conda-forge sentence-transformers (conda 환경일 경우)\n    ```\n    다른 라이브러리(`pandas`, `numpy`, `seaborn`, `matplotlib`)도 마찬가지로 설치되어 있어야 합니다.\n    ```bash\n    pip install pandas numpy seaborn matplotlib\n    ```\n3.  **SBERT 모델 로드:**\n    *   `sbert_model_name \u003d \u0027all-MiniLM-L6-v2\u0027`로 모델 이름을 명시적으로 지정했습니다. 다른 SBERT 모델을 사용하고 싶다면 이 부분을 변경할 수 있습니다.\n    *   모델 로드 시 인터넷 연결이 필요할 수 있습니다 (처음 다운로드 시).\n4.  **데이터프레임 컬럼 확인:** 코드 중간에