_order \u003d sorted(df[\u0027model\u0027].unique())\n    corpus_dict \u003d {}\n    for model_name in model_order:\n        model_texts \u003d df[df[\u0027model\u0027] \u003d\u003d model_name][\u0027answer\u0027].tolist()\n        corpus_dict[model_name] \u003d \u0027 \u0027.join(model_texts)\n    \n    # TfidfVectorizer에 입력으로 사용할 리스트 (순서 중요)\n    corpus \u003d [corpus_dict[model_name] for model_name in model_order]\n    model_labels_for_tfidf \u003d model_order # 히트맵 때와 동일한 순서 유지\n\n    print(f\"통합된 문서 개수 (모델 개수): {len(corpus)}\")\n    # print(f\"모델 순서: {model_labels_for_tfidf}\")\n    # print(f\"첫 번째 모델 ({model_labels_for_tfidf[0]})의 텍스트 일부: {corpus[0][:200]}...\")\nelse:\n    print(\"오류: \u0027model\u0027 또는 \u0027answer\u0027 컬럼이 데이터프레임에 없습니다.\")\n    exit()\n\n# --- 2. 텍스트 전처리 함수 정의 ---\nstop_words \u003d set(stopwords.words(\u0027english\u0027))\nlemmatizer \u003d WordNetLemmatizer()\n\ndef preprocess_text(text):\n    # 1. 소문자 변환\n    text \u003d text.lower()\n    # 2. 기본적인 구두점 및 숫자 제거 (단, 단어 내부의 하이픈 등은 유지할 수 있도록 정규식 조정)\n    #    완전히 제거하기보다는, 분석 목적에 따라 유지할 수도 있습니다.\n    #    여기서는 알파벳과 공백만 남기는 간단한 방식을 사용합니다. (좀 더 정교하게 할 수도 있음)\n    text \u003d re.sub(r\u0027[^a-z\\s]\u0027, \u0027\u0027, text) # 알파벳 소문자와 공백 제외 모두 제거\n    # 3. 토큰화\n    tokens \u003d word_tokenize(text)\n    # 4. 불용어 제거 및 표제어 추출\n    processed_tokens \u003d [lemmatizer.lemmatize(word) for word in tokens if word not in stop_words and len(word) \u003e 2] # 길이가 2 초과인 단어만\n    return \u0027 \u0027.join(processed_tokens)\n\nprint(\"\\n텍스트 전처리를 수행 중입니다... (시간이 다소 소요될 수 있습니다)\")\npreprocessed_corpus \u003d [preprocess_text(doc) for doc in corpus]\nprint(\"텍스트 전처리가 완료되었습니다.\")\n# print(f\"전처리된 첫 번째 모델 ({model_labels_for_tfidf[0]})의 텍스트 일부: {preprocessed_corpus[0][:200]}...\")\n\n\n# --- 3. TF-IDF 계산 ---\n# TfidfVectorizer 초기화\n# max_features: TF-IDF 행렬에 포함할 최대 단어 수 (TF-IDF 값이 높은 순)\n# ngram_range: (min_n, max_n) - 예: (1,1)은 유니그램, (1,2)는 유니그램과 바이그램 모두 고려\nvectorizer \u003d TfidfVectorizer(\n    max_features\u003d5000,  # 예시로 5000개 단어만 고려 (조정 가능)\n    ngram_range\u003d(1, 1), # 유니그램만 사용 (원하면 (1,2) 등으로 변경)\n    # tokenizer\u003dpreprocess_text # TfidfVectorizer는 내부적으로 토큰화를 수행. 만약 위에서 이미 전처리된 텍스트를 넣는다면, tokenizer는 불필요하거나 lambda x: x.split() 정도로 간단히.\n                                # 여기서는 이미 전처리된 문자열 리스트를 넣으므로 기본 토크나이저(공백 기준) 사용.\n)\n\nprint(\"\\nTF-IDF를 계산 중입니다...\")\ntfidf_matrix \u003d vectorizer.fit_transform(preprocessed_corpus)\nprint(\"TF-IDF 계산이 완료되었습니다.\")\n\n# TF-IDF 행렬의 형태 확인: (문서 수, 단어 수)\nprint(f\"TF-IDF 행렬 형태: {tfidf_matrix.shape}\")\n\n# 단어 목록 (feature names)\nfeature_names \u003d vectorizer.get_feature_names_out()\n\n\n# --- 4. 결과 확인: 모델별 상위 N개 TF-IDF 단어 ---\ndef get_top_tfidf_words(tfidf_row, feature_names_list, top_n\u003d10):\n    \"\"\"특정 문서(행)에 대해 TF-IDF 점수가 높은 상위 N개 단어와 점수를 반환\"\"\"\n    # TF-IDF 행렬의 해당 행을 dense array로 변환하고 1차원으로 만듦\n    scores \u003d tfidf_row.toarray().flatten()\n    # 점수가 높은 순으로 인덱스 정렬\n    sorted_indices \u003d np.argsort(scores)[::-1]\n    \n    top_words \u003d []\n    for i in range(top_n):\n        if i \u003c len(sorted_indices): # 단어 수가 top_n보다 적을 수 있음\n            idx \u003d sorted_indices[i]\n            if scores[idx] \u003e 0: # TF-IDF 점수가 0보다 큰 경우만\n                top_words.append((feature_names_list[idx], scores[idx]))\n    return top_words\n\nprint(\"\\n--- 모델별 상위 TF-IDF 단어 (Top 10) ---\")\nfor i, model_name in enumerate(model_labels_for_tfidf):\n    print(f\"\\n[ {model_name} ]\")\n    top_words \u003d get_top_tfidf_words(tfidf_matrix[i], feature_names, top_n\u003d10)\n    if top_words:\n        for word, score in top_words:\n            print(f\"  - {word}: {score:.4f}\")\n    else:\n        print(\"  (해당 모델에 대한 TF-IDF 상위 단어를 찾을 수 없습니다.)\")\n\n# (선택 사항) TF-IDF 결과를 DataFrame으로 만들어 보기\n# 각 행은 모델, 각 열은 단어, 값은 TF-IDF 점수\ntfidf_df \u003d pd.DataFrame(tfidf_matrix.toarray(), index\u003dmodel_labels_for_tfidf, columns\u003dfeature_names)\nprint(\"\\n\\n--- TF-IDF Matrix (일부 샘플) ---\")\n# 너무 많은 컬럼이 나올 수 있으므로, 상위 몇 개 단어만 선택해서 보거나, 특정 단어만 필터링해서 볼 수 있습니다.\n# 예시: 전체 모델에서 TF-IDF 총합이 높은 상위 20개 단어만 보기\ntop_20_features_sum \u003d tfidf_df.sum(axis\u003d0).sort_values(ascending\u003dFalse).head(20).index\nprint(tfidf_df[top_20_features_sum].head()) # .head()는 처음 5개 모델만 보여줌\n\n```\n\n**코드 설명:**\n\n1.  **데이터 준비 (`corpus_dict`, `corpus`):**\n    *   `df.groupby(\u0027model\u0027)[\u0027answer\u0027].apply(lambda x: \u0027 \u0027.join(x))` 대신, `model_order`를 정의하고 순서대로 딕셔너리에 저장한 후 리스트로 만듭니다. 이는 나중에 `TfidfVectorizer`의 결과 순서와 모델 레이블 순서를 일치시키기 위함입니다.\n    *   각 모델의 모든 답변들을 하나의 큰 문자열로 합쳐 `corpus` 리스트에 저장합니다. 각 리스트의 요소가 하나의 \"문서\"가 됩니다.\n2.  **텍스트 전처리 (`preprocess_text` 함수):**\n    *   **소문자 변환:** `text.lower()`\n    *   **정규식을 이용한 정제:** `re.sub(r\u0027[^a-z\\s]\u0027, \u0027\u0027, text)`는 알파벳 소문자와 공백을 제외한 모든 문자를 제거합니다. 실제 분석에서는 이 부분을 더 정교하게 다듬어야 할 수 있습니다 (예: 특정 구두점 유지, 숫자 처리 방식 등).\n    *   **토큰화:** `word_tokenize(text)`를 사용하여 문자열을 단어 단위로 나눕니다.\n    *   **불용어 제거 및 표제어 추출:** `stopwords.words(\u0027english\u0027)`로 영어 불용어 사전을 가져와 제거하고, `WordNetLemmatizer`를 사용하여 각 단어를 기본형(표제어)으로 변환합니다. `len(word) \u003e 2` 조건으로 너무 짧은 단어는 제외합니다.\n3.  **TF-IDF 계산 (`TfidfVectorizer`):**\n    *   `TfidfVectorizer` 객체를 생성합니다.\n        *   `max_features\u003d5000`: 전체 단어 중 TF-IDF 점수가 높은 상위 5000개 단어만 사용하여 TF-IDF 행렬을 만듭니다. 이 값은 데이터셋 크기나 분석 목적에 따라 조절합니다.\n        *   `ngram_range\u003d(1, 1)`: 단어 하나(유니그램)만을 특징으로 사용합니다. 만약 \"machine learning\"과 같은 구문을 하나의 특징으로 보고 싶다면 `(1, 2)` 등으로 설정할 수 있습니다.\n    *   `vectorizer.fit_transform(preprocessed_corpus)`: 전처리된 텍스트 코퍼스에 `TfidfVectorizer`를 적용하여 TF-IDF 행렬을 계산합니다.\n    *   `vectorizer.get_feature_names_out()`: TF-IDF 행렬의 각 열에 해당하는 단어(특징) 이름을 가져옵니다.\n4.  **결과 확인 (`get_top_tfidf_words` 함수):**\n    *   `tfidf_matrix[i]`는 i번째 모델(문서)에 대한 TF-IDF 벡터입니다.\n    *   이 벡터에서 점수가 높은 순으로 단어를 정렬하여 상위 N개를 추출하고, 해당 모델의 주요 키워드로 간주할 수 있습니다.\n5.  **DataFrame으로 변환 (선택 사항):**\n    *   계산된 TF-IDF 행렬을 Pandas DataFrame으로 만들면 더 쉽게 결과를 탐색하고 추가 분석을 수행할 수 있습니다.\n    *   `tfidf_df.sum(axis\u003d0).sort_values(ascen